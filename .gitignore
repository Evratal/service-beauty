# --- Секреты и локальная конфигурация ---
# .env содержит реальные значения и НИКОГДА не попадает в репозиторий.
# В репозитории лежит только .env.example с перечнем переменных.
.env
.env.local
*.env
!.env.example

# Секреты Яндекс OAuth. Файл нужен только локально, в репозиторий не идёт.
yandex-creds.txt

# --- База данных ---
# Файл базы создаётся скриптом миграций. В нём лежат хеши паролей,
# токены и персональные данные клиентов, поэтому в репозиторий он не идёт.
data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
backup/

# --- Зависимости ---
# Папка создаётся автоматически по package.json и не должна попадать в Git.
node_modules/

# --- Отчёты по безопасности ---
# Конспект требует не отправлять отчёт аудита в репозиторий:
# история Git сохраняется, даже если репозиторий потом станет открытым.
security-report*.md
audit-report*.md

# --- Материалы курса ---
# Конспекты, шаблоны и условия домашних заданий — исходные материалы,
# они не являются частью проекта. Копия паспорта лежит в docs/.
# Шаблоны привязаны к корню репозитория (слеш в начале), чтобы случайно
# не заигнорировать файлы отчётов в docs/ (например, docs/Task_4_2.5_report.md).
/Task_*
/Урок *.txt
/Урок *.docx
/Шаблон *.docx
/Шаблон *.txt
/Библиотека промптов*.txt
*.docx

# --- Скриншоты для сдачи ---
# Временные и отладочные кадры, в репозитории не нужны.
prototype/screenshots/*-tmp*.png
*-debug*.png

# --- IDE ---
.idea/
.vscode/
*.iml

# --- Окружение и логи ---
.venv/
venv/
env/
*.log
npm-debug.log*
.DS_Store
Thumbs.db
